{
  "template": {
    "settings": {
      "index": {
        "mode": "logsdb",
        "number_of_replicas": "1",
        "default_pipeline": "geoip"
      }
    },
    "mappings": {
      "properties": {
        "enriched": {
          "type": "object",
          "properties": {
            "First_Name": {
              "type": "keyword"
            },
            "Last_Name": {
              "type": "keyword"
            },
            "Department": {
              "type": "keyword"
            },
            "Team": {
              "type": "keyword"
            },
            "Employee_ID": {
              "type": "keyword"
            },
            "Start_Date": {
              "type": "date"
            }
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "geo": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "geo_point"
                }
              }
            },
            "ip": {
              "type": "ip"
            }
          }
        },
        "host": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "destination": {
          "type": "object",
          "properties": {
            "geo": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "geo_point"
                }
              }
            },
            "ip": {
              "type": "ip"
            }
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "geo": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "geo_point"
                }
              }
            },
            "ip": {
              "type": "ip"
            }
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "geo": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "geo_point"
                }
              }
            },
            "ip": {
              "type": "ip"
            }
          }
        }
      }
    }
  },
  "index_patterns": [
    "logs_on_double_secret_probation*"
  ],
  "allow_auto_create": true
}
